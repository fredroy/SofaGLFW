# CMake package configuration file for the @PROJECT_NAME@ module

@PACKAGE_GUARD@
@PACKAGE_INIT@

find_package(SofaGLFW REQUIRED)
# OpenGL components, when SofaImGui was built with them (with the OpenGL backend).
set(SOFAIMGUI_HAVE_SOFA_GL_COMPONENT_RENDERING3D @SOFAIMGUI_HAVE_SOFA_GL_COMPONENT_RENDERING3D@)
if(SOFAIMGUI_HAVE_SOFA_GL_COMPONENT_RENDERING3D)
    find_package(Sofa.GL.Component.Rendering3D REQUIRED)
endif()

if(NOT TARGET @PROJECT_NAME@)
    include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
endif()

check_required_components(@PROJECT_NAME@)
